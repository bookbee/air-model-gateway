# air-model-gateway settings. Copy to .env for local development.
#
# Every setting is an env var with the AIR_MODEL_GATEWAY_ prefix; nested groups use
# a double underscore (AIR_MODEL_GATEWAY_OLLAMA__BASE_URL). In shared environments
# secrets can instead be files in AIR_MODEL_GATEWAY_SECRETS_DIR, one file per
# variable, named exactly like it (see "secrets" below). Env vars win over files.

# ---- core ------------------------------------------------------------------
# Anything but `local` fails closed: the policy file's `default_allow` is ignored,
# so every caller needs an explicit grant.
AIR_MODEL_GATEWAY_ENVIRONMENT=local            # local | staging | prod
# The build's git revision, shown by /v1/health. Not set by hand: the image bakes
# it in and `make run` exports it from the checkout.
# AIR_MODEL_GATEWAY_REVISION=unknown
AIR_MODEL_GATEWAY_LOG__LEVEL=INFO
AIR_MODEL_GATEWAY_LOG__RENDER=console          # console | json (json in shared envs)
# The listen address is not a setting: it comes from `uvicorn --host/--port`
# (Dockerfile CMD, `make run`).

# ---- callers ---------------------------------------------------------------
# Comma-separated "token:service" pairs. The service name must match a
# `services:` key in the policy file. air-classifier-dev and air-client-dev are
# the local tokens the classifier's and web console's own .env.example files send.
AIR_MODEL_GATEWAY_SECURITY__SERVICE_TOKENS=air-classifier-dev:air-classifier-service,air-orchestrator-service-dev:air-orchestrator-service,air-client-dev:air-web-console,air-tools-dev:air-tools,air-rag-dev:air-rag

# ---- providers ---------------------------------------------------------------
# Ollama. `make run` and `make up` override this to match OLLAMA=native|container,
# so it only matters when running uvicorn by hand.
AIR_MODEL_GATEWAY_OLLAMA__BASE_URL=http://localhost:11434
# How long Ollama keeps a model loaded after a call. Ollama's own default (5m)
# makes every consumer pay a cold reload after a quiet spell.
AIR_MODEL_GATEWAY_OLLAMA__KEEP_ALIVE=30m

# The self-hosted slot: any OpenAI-compatible server. llama.cpp's llama-server
# locally (`make llamacpp-up`, port 8181), vLLM/TGI in shared environments.
# A key is only needed if the server enforces one.
AIR_MODEL_GATEWAY_SELF_HOSTED__BASE_URL=http://localhost:8181/v1
AIR_MODEL_GATEWAY_SELF_HOSTED__API_KEY=

# Cloud keys. A provider without a key is skipped and its chains fail over.
AIR_MODEL_GATEWAY_PROVIDERS__ANTHROPIC_API_KEY=
AIR_MODEL_GATEWAY_PROVIDERS__OPENAI_API_KEY=
AIR_MODEL_GATEWAY_PROVIDERS__GEMINI_API_KEY=   # https://aistudio.google.com/apikey

# ---- routing -----------------------------------------------------------------
# Owner-managed tables: what each model class and embedding name means (chains
# and per-service tuning), and USD per million tokens.
# Edit and restart. Locally a missing file falls back to the built-in tables;
# outside local the gateway refuses to start without it.
AIR_MODEL_GATEWAY_GATEWAY__ROUTING_CONFIG_PATH=deploy/routing.yaml
AIR_MODEL_GATEWAY_GATEWAY__PRICING_CONFIG_PATH=deploy/pricing.yaml

# ---- resilience --------------------------------------------------------------
# Deadline per provider attempt; on expiry the router fails over to the next rung.
# For a stream (`stream: true`) this is the deadline to its first token.
AIR_MODEL_GATEWAY_GATEWAY__REQUEST_TIMEOUT_SECONDS=60
# Streams (`stream: true`) only: the longest a stream may go silent after its first
# token. Time to first token is REQUEST_TIMEOUT_SECONDS, like any call's attempt.
AIR_MODEL_GATEWAY_GATEWAY__STREAM_IDLE_TIMEOUT_SECONDS=30
# Extra passes over a chain when every rung failed and at least one failure was
# transient (timeout, 429, 5xx, dropped connection). Backoff doubles per retry,
# with jitter. The provider SDKs' own retries are off, so this is the only layer.
AIR_MODEL_GATEWAY_GATEWAY__RETRY_ATTEMPTS=1
AIR_MODEL_GATEWAY_GATEWAY__RETRY_BACKOFF_SECONDS=0.5
# Circuit breaker per (provider, model): after this many consecutive transient
# failures the rung is skipped for RESET seconds, then one trial call decides.
AIR_MODEL_GATEWAY_GATEWAY__BREAKER_FAILURE_THRESHOLD=5
AIR_MODEL_GATEWAY_GATEWAY__BREAKER_RESET_SECONDS=30

# ---- cache -------------------------------------------------------------------
AIR_MODEL_GATEWAY_GATEWAY__CACHE_ENABLED=true
AIR_MODEL_GATEWAY_GATEWAY__CACHE_TTL_SECONDS=300
# In-process cache only (Redis bounds itself): caps entries regardless of TTL.
AIR_MODEL_GATEWAY_GATEWAY__CACHE_MAX_ENTRIES=10000

# ---- redis (shared cache, rate limits, quotas, spend) ----------------------
# Empty = in-process state: correct for one replica. Required before
# running more than one, or each replica enforces its own copy of every limit.
# `make run` / `make up` set this from REDIS=none|infra (infra = the Redis that
# air-infrastructure-service runs on :6379); it only matters for uvicorn by hand.
AIR_MODEL_GATEWAY_REDIS__URL=
AIR_MODEL_GATEWAY_REDIS__KEY_PREFIX=air-model-gateway:
# Redis is on the request path; past this the call degrades instead of waiting.
AIR_MODEL_GATEWAY_REDIS__SOCKET_TIMEOUT_SECONDS=0.25

# ---- policy ------------------------------------------------------------------
# Grants, per-service rates, daily budgets, direct-model access and provider
# quotas all live in this file (deploy/policy/policy.<env>.yaml per environment).
AIR_MODEL_GATEWAY_POLICY__CONFIG_PATH=deploy/policy/policy.local.yaml
# Requests per minute for a service the policy file gives no rate of its own.
AIR_MODEL_GATEWAY_POLICY__DEFAULT_RATE_PER_MINUTE=120

# ---- secrets -----------------------------------------------------------------
# Optional directory of secret files (Vault Agent, Kubernetes secret volume,
# cloud secret-store CSI driver). Each file is named like the variable it sets,
# e.g. $AIR_MODEL_GATEWAY_SECRETS_DIR/AIR_MODEL_GATEWAY_PROVIDERS__ANTHROPIC_API_KEY.
# Set it in the process environment (container spec), not in this file:
# it is read before .env is.
#AIR_MODEL_GATEWAY_SECRETS_DIR=/run/secrets/air-model-gateway
