# air-model-gateway settings. Copy to .env for local dev.
# Nested keys use a double-underscore delimiter: AIR_MODEL_GATEWAY_OLLAMA__BASE_URL.

# ---- core ------------------------------------------------------------------
AIR_MODEL_GATEWAY_ENVIRONMENT=local            # local | staging | prod
# Reserved, not currently consulted: the real bind host/port comes from the
# `uvicorn` CLI invocation (Dockerfile CMD / Makefile `run` target), not from
# these. Changing them here has no effect until that changes too.
AIR_MODEL_GATEWAY_API__HOST=0.0.0.0
AIR_MODEL_GATEWAY_API__PORT=8080
AIR_MODEL_GATEWAY_LOG__LEVEL=INFO
AIR_MODEL_GATEWAY_LOG__RENDER=console          # console | json (json in prod)

# Comma-separated "token:service" pairs air-model-gateway accepts (one service per token).
# In prod these are injected by DevOps (Vault/cloud secrets manager), never from
# a file in this repo — air-model-gateway has no runtime dependency on air-infra to source
# them from (docs/00-plan.md §1).
AIR_MODEL_GATEWAY_SECURITY__SERVICE_TOKENS=air-classifier-dev:air-classifier,air-orchestrator-service-dev:air-orchestrator-service,air-client-dev:air-client

# ---- providers ---------------------------------------------------------------
# Where air-model-gateway finds ollama. Under compose this value is OVERRIDDEN by
# docker-compose.yml, which sets it from `make up` (native by default, reaching
# the ollama already running on the host; `OLLAMA=container make up` for the
# bundled container instead) — `environment:` wins over `env_file:`, so leave
# this alone unless you run air-model-gateway on the host with `make run`.
AIR_MODEL_GATEWAY_OLLAMA__BASE_URL=http://host.docker.internal:11434
# Sent on every /api/chat and /api/embed call. Without it Ollama's own default
# (5m) applies and every AIR service sharing this Ollama instance pays a
# reload cold-start the next time any of them calls it past that window —
# fixed centrally here rather than in each consumer's own workaround.
AIR_MODEL_GATEWAY_OLLAMA__KEEP_ALIVE=30m

# Any OpenAI-wire-compatible self-hosted backend — llama.cpp's `llama-server`
# locally (`make llamacpp-up`, default port 8181), vLLM/TGI in prod. LM Studio
# also works unchanged (default port 1234) if you'd rather use that. No API
# key needed for any of these locally; set one only if your self-hosted server
# enforces a token. Same host.docker.internal treatment as Ollama above when
# running under compose.
AIR_MODEL_GATEWAY_SELF_HOSTED__BASE_URL=http://host.docker.internal:8181/v1
AIR_MODEL_GATEWAY_SELF_HOSTED__API_KEY=

# Cloud provider keys — leave blank locally; DevOps-injected in prod.
AIR_MODEL_GATEWAY_PROVIDERS__ANTHROPIC_API_KEY=
AIR_MODEL_GATEWAY_PROVIDERS__OPENAI_API_KEY=
# Google AI Studio key (https://aistudio.google.com/apikey).
AIR_MODEL_GATEWAY_PROVIDERS__GEMINI_API_KEY=

# ---- gateway -----------------------------------------------------------------
AIR_MODEL_GATEWAY_GATEWAY__DEFAULT_PROVIDER=ollama        # ollama | anthropic | openai | gemini
AIR_MODEL_GATEWAY_GATEWAY__DEFAULT_MODEL=llama3.2:3b
AIR_MODEL_GATEWAY_GATEWAY__CACHE_TTL_SECONDS=300
AIR_MODEL_GATEWAY_GATEWAY__CACHE_ENABLED=true
# Bounds the in-process cache regardless of TTL — a write-once entry is only
# reclaimed lazily, on its own next lookup, so TTL alone does not bound memory.
AIR_MODEL_GATEWAY_GATEWAY__CACHE_MAX_ENTRIES=10000

# Routing and pricing are DevOps-owned config, not code: an alias's failover chain
# and a model's price are edited in these files and picked up on restart. A missing
# file falls back to the built-in tables, so a bare checkout still runs.
AIR_MODEL_GATEWAY_GATEWAY__ROUTING_CONFIG_PATH=deploy/routing.yaml
AIR_MODEL_GATEWAY_GATEWAY__PRICING_CONFIG_PATH=deploy/pricing.yaml

# Deadline on a single provider attempt. On expiry the router fails over to the
# next rung of the chain instead of holding the caller's connection open.
AIR_MODEL_GATEWAY_GATEWAY__REQUEST_TIMEOUT_SECONDS=60

# ---- policy / limits -----------------------------------------------------------
AIR_MODEL_GATEWAY_POLICY__CONFIG_PATH=deploy/policy/policy.local.yaml
AIR_MODEL_GATEWAY_POLICY__DEFAULT_RATE_PER_MINUTE=120
